//@version=5
indicator("GVN Master Pro Ultimate (RSI AI Dashboard & Engulfing E-SL-T)", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 🌟 MARKET MODE SELECTOR (ONE-CLICK SETUP)
// ==========================================
marketMode = input.string("Main Market", "Select Market Mode", options=["Main Market", "Option Market", "Custom Setting"], group="Market Selection Settings")

// =====================
// TOGGLING TABLES (Raw Inputs)
// =====================
in_showTable1 = input.bool(true, "Show 1st Entry Table", group="Table Settings")
in_showTable2 = input.bool(true, "Show 2nd Entry Table", group="Table Settings")
in_showTable3 = input.bool(true, "Show 3rd (Z to H) Entry Table", group="Table Settings")
firstPosInput  = input.string("Bottom Left",  "1st Entry Table Position", options=["Top Left","Middle Left","Bottom Left","Top Center","Middle Center","Bottom Center"], group="Table Settings")
secondPosInput = input.string("Bottom Center",   "2nd Entry Table Position", options=["Top Center","Middle Center","Bottom Center","Top Right","Middle Right","Bottom Right"], group="Table Settings")
thirdPosInput  = input.string("Bottom Right","3rd Entry Table Position", options=["Top Center","Middle Center","Bottom Center","Bottom Left","Top Right","Middle Right","Bottom Right"], group="Table Settings")
tableFont = input.string("tiny", "Table Font Size", options = ["tiny","small","normal","large"], group="Table Settings")

// =====================
// LABELS SETTINGS (SL & GVN - Raw Inputs)
// =====================
in_showSLLabels        = input.bool(false, "Show SL Labels", group="Labels Settings")
in_showGVNLabel       = input.bool(true, "Show GVN POC Label", group="Labels Settings")
in_showFibLabels      = input.bool(true, "Show Fibonacci Level Labels", group="Labels Settings")
in_showBuySellConf    = input.bool(false, "Show Basic Buy/Sell Signals", group="Labels Settings")
in_showAlgoSignals    = input.bool(true, "Show Algo Perfect Signals", group="Labels Settings")
in_showMomentumFlashes = input.bool(true, "Show Momentum Flashes", group="Labels Settings")
in_showGVNS           = input.bool(false, "Show GVNS Level", group="Labels Settings")

// Option Market Custom Labels Settings
lbl_opt_gvn100 = input.string("Auto", "Option Mode Gvn=i1 (Top) Label", tooltip="Set to 'Auto' to dynamically use '0.0' for Call options and '0.1' for Put options.", group="Labels Settings")
lbl_opt_i2     = input.string("0.2", "Option Mode Gvn=i2 Label", group="Labels Settings")
lbl_opt_i3     = input.string("0.3", "Option Mode Gvn=i3 Label", group="Labels Settings")
lbl_opt_i5     = input.string("0.5", "Option Mode Gvn=i5 Label", group="Labels Settings")
lbl_opt_i6     = input.string("0.6", "Option Mode Gvn=i6 Label", group="Labels Settings")
lbl_opt_i7     = input.string("0.7", "Option Mode Gvn=i7 Label", group="Labels Settings")
lbl_opt_gvn0   = input.string("0.1", "Option Mode Gvn=i0 (Bottom) Label", group="Labels Settings")

// =====================
// MAIN LINES SETTINGS (Raw Inputs)
// =====================
in_showMainLines = input.bool(false, "Main Market Only (1 Click Show All)", group="Main Lines Settings")
lineStyleInput = input.string("Solid", "Main Market Lines Style", options=["Solid", "Circles", "Cross", "Step Line"], group="Main Lines Settings")

in_showCP = input.bool(false, "Show CP Level", group="Main Lines Settings")
in_showTradeBoxes = input.bool(true, "Show GVN Trade Entry Boxes", group="Main Lines Settings")
in_showInstZones = input.bool(true, "Show Institutional S/R Zones", group="Main Lines Settings")

// ==========================================
// 🕯️ ENGULFING & SPECIAL CANDLE COLOR SETTINGS
// ==========================================
in_colorBars       = input.bool(true, "Color Engulfing Setup Candles Only", group="Candle Coloring Settings")
in_bullEngColor    = input.color(color.rgb(16, 231, 124), "Engulfing Setup Color", group="Candle Coloring Settings")
in_bearEngColor    = input.color(color.rgb(231, 42, 42), "Bearish Rejection Color", group="Candle Coloring Settings")

in_showOpenLowHigh = input.bool(true, "Show Open=Low / Open=High Candles", group="Candle Coloring Settings")
in_openLowColor    = input.color(color.black, "Open=Low Candle Color", group="Candle Coloring Settings")
in_openHighColor   = input.color(color.purple, "Open=High Candle Color", group="Candle Coloring Settings")

in_showExhaustion   = input.bool(true, "Show GVN Level Exhaustion Candles", group="Candle Coloring Settings")
in_exhaustBullColor = input.color(color.yellow, "Support Rejection Color", group="Candle Coloring Settings")
in_exhaustBearColor = input.color(color.rgb(255, 110, 0), "Resistance Rejection Color", group="Candle Coloring Settings")

// ==========================================
// 🎯 ENGULFING E, SL, T SETUP MARKINGS
// ==========================================
in_showEST      = input.bool(true, "Show 2-Dot Dotted e, sl, t Line Markings", group="Engulfing Trade Setup (e, sl, t)")
in_estFontSize  = input.string("small", "e, sl, t Label Font Size", options=["tiny", "small", "normal", "large"], group="Engulfing Trade Setup (e, sl, t)")
in_slBuffer     = input.float(2.0, "SL Buffer (Points below Low)", minval=0.5, step=0.5, group="Engulfing Trade Setup (e, sl, t)")

// =====================
// AUTO VOLUME PROFILE (Raw Inputs)
// =====================
vpLookback = input.int(100, "Fixed Range Volume Lookback", minval=10, group="Auto Volume Profile (POC)")
vpStep = input.float(5.0, "Volume Profile Price Step", minval=0.5, group="Auto Volume Profile (POC)")
in_showVP = input.bool(true, "Show Automatic POC Line", group="Auto Volume Profile (POC)")

// =====================
// 80% Previous Day's Levels (Raw Inputs)
// =====================
in_show80Lines = input.bool(true, 'Show 80% Previous Day Levels', group='80% Levels')

// ==========================================
// 🤖 GVN AI SMART DASHBOARD (RSI COMPACT DASHBOARD)
// ==========================================
in_showAI = input.bool(true, "Show AI Dashboard", group="AI Dashboard Settings")
aiBoxPos = input.string("Bottom Right", "AI Dashboard Position", options=["Top Left", "Middle Left", "Bottom Left", "Top Center", "Middle Center", "Bottom Center", "Top Right", "Middle Right", "Bottom Right"], group="AI Dashboard Settings")
aiFontInput = input.string("tiny", "AI Dashboard Font Size", options=["tiny", "small", "normal", "large"], group="AI Dashboard Settings")

// ==========================================
// 📈 ADVANCED 200 EMA
// ==========================================
in_show200EMA = input.bool(true, "Show Advanced 200 EMA", group="200 EMA Settings")
emaColor = input.color(color.black, "200 EMA Color", group="200 EMA Settings")

// ==========================================
// 🛡️ DYNAMIC ATR-BASED STOP LOSS SETTINGS
// ==========================================
in_useDynamicSL = input.bool(true, "Use Dynamic ATR-based Stop Loss", group="Dynamic SL Settings")
in_atrLength    = input.int(14, "ATR Length for Stop Loss", minval=1, group="Dynamic SL Settings")
in_atrMult      = input.float(0.7, "ATR Multiplier for Stop Loss", minval=0.1, step=0.1, group="Dynamic SL Settings")

// ==========================================
// 🎨 LINE COLOR CUSTOMIZATION SETTINGS
// ==========================================
color_N1 = input.color(color.green, "Main Market 1 (N1) Color", group="Main Lines Settings")
color_N2 = input.color(color.rgb(231, 42, 42), "Main Market 2 (N2) Color", group="Main Lines Settings")
color_C1 = input.color(color.rgb(243, 121, 64), "Main Market 3 (C1) Color", group="Main Lines Settings")

color_gvn0   = input.color(color.rgb(16,231,124), "Gvn=i0 (Base 0) Color", group="GVN & Option Levels Colors")
color_gvn100 = input.color(color.aqua, "Gvn=i1 (Base 100) Color", group="GVN & Option Levels Colors")
color_i2     = input.color(color.red, "Gvn=i2 Color", group="GVN & Option Levels Colors")
color_i3     = input.color(color.rgb(231,43,168), "Gvn=i3 Color", group="GVN & Option Levels Colors")
color_i5     = input.color(color.rgb(11,46,201), "Gvn=i5 Color", group="GVN & Option Levels Colors")
color_i6     = input.color(color.purple, "Gvn=i6 Color", group="GVN & Option Levels Colors")
color_i7     = input.color(color.black, "Gvn=i7 Color", group="GVN & Option Levels Colors")

color_vwap = input.color(color.rgb(137, 35, 233), "VWAP Color", group="Other Indicators Colors")
color_hcl  = input.color(color.red, "Hcl Color", group="Other Indicators Colors")
color_cp   = input.color(color.black, "CP Color", group="Other Indicators Colors")

showTable1          = (marketMode == "Main Market") ? false : (marketMode == "Option Market") ? true  : in_showTable1
showTable2          = (marketMode == "Main Market") ? false : (marketMode == "Option Market") ? true  : in_showTable2
showTable3          = (marketMode == "Main Market") ? false : (marketMode == "Option Market") ? true  : in_showTable3

showSLLabels        = in_showSLLabels
showGVNLabel        = (marketMode == "Main Market") ? false : (marketMode == "Option Market") ? true  : in_showGVNLabel
showFibLabels       = in_showFibLabels
showBuySellConf     = in_showBuySellConf
showAlgoSignals     = in_showAlgoSignals
showMomentumFlashes = in_showMomentumFlashes
showGVNS            = in_showGVNS

showMainLines       = (marketMode == "Main Market") ? true  : (marketMode == "Option Market") ? false : in_showMainLines
mLineStyle          = lineStyleInput == "Circles" ? plot.style_circles : lineStyleInput == "Cross" ? plot.style_cross : lineStyleInput == "Step Line" ? plot.style_stepline : plot.style_linebr

showCP              = (marketMode == "Option Market") ? true : in_showCP
showBarColor        = (marketMode == "Main Market") ? true  : (marketMode == "Option Market") ? true  : in_showOpenLowHigh
showTradeBoxes      = (marketMode == "Main Market") ? false : (marketMode == "Option Market") ? false : in_showTradeBoxes
showInstZones       = (marketMode == "Main Market") ? true  : (marketMode == "Option Market") ? true  : in_showInstZones

showVP              = (marketMode == "Main Market") ? false : (marketMode == "Option Market") ? true  : in_showVP
show80Lines         = (marketMode == "Main Market") ? true  : (marketMode == "Option Market") ? true  : in_show80Lines
showAI              = (marketMode == "Main Market") ? true  : (marketMode == "Option Market") ? true  : in_showAI
show200EMA          = (marketMode == "Main Market") ? true  : (marketMode == "Option Market") ? true  : in_show200EMA

// 9:15 Base Range
var float baseHigh = na
var float baseLow  = na

if (hour(time) == 9 and minute(time) == 15)
    baseHigh := high
    baseLow  := low

baseDiff = baseHigh - baseLow
baseMid  = baseDiff / 2

N1 = baseHigh + baseMid
N2 = baseLow  + baseMid
C1 = (N1 + N2) / 2

bool isIndexMode = showMainLines 

float fibR = baseDiff / 0.118
float gvn0 = na
float gvn100 = na

if not isIndexMode
    gvn0   := N2 * 0.118 / 0.5
    gvn100 := N1 * 0.786 / 0.5
else
    gvn0   := N2 - (0.5 * fibR)
    gvn100 := gvn0 + fibR

float gvnR = gvn100 - gvn0

float i2 = gvn0 + (isIndexMode ? 0.786 : 0.763) * gvnR
float i3 = gvn0 + 0.618 * gvnR
float i5 = gvn0 + 0.5   * gvnR
float i6 = gvn0 + 0.382 * gvnR
float i7 = gvn0 + (isIndexMode ? 0.236 : 0.220) * gvnR

isFirstBar = (hour(time) == 9 and minute(time) == 15)

plot_N1 = isFirstBar ? na : N1
plot_N2 = isFirstBar ? na : N2
plot_C1 = isFirstBar ? na : C1

plot(showMainLines ? plot_N1 : na, "Main Market 1", color=color_N1, linewidth=2, style=mLineStyle)
plot(showMainLines ? plot_N2 : na, "Main Market 2", color=color_N2, linewidth=2, style=mLineStyle)
plot(showMainLines ? plot_C1 : na, "Main Market 3", color=color_C1, linewidth=1, style=mLineStyle)

float seeda_0 = isIndexMode ? N1 + (0.5 * fibR) : na
float seeda_236 = isIndexMode ? seeda_0 - (0.236 * fibR) : na
float seeda_382 = isIndexMode ? seeda_0 - (0.382 * fibR) : na
float seeda_500 = isIndexMode ? seeda_0 - (0.5 * fibR) : na
float seeda_618 = isIndexMode ? seeda_0 - (0.618 * fibR) : na
float seeda_786 = isIndexMode ? seeda_0 - (0.786 * fibR) : na
float seeda_1000 = isIndexMode ? seeda_0 - fibR : na
float ext_up_1618_ulta = isIndexMode ? (gvn0 + 1.618 * fibR) : na
float ext_dn_1618_seeda = isIndexMode ? (seeda_0 - 1.618 * fibR) : na 

// ==========================================
// 🎨 SOLID LEVEL LINES HELPER (OPTION MARKET: ORIGINAL SINGLE COLORS | MAIN MARKET: DUAL SPLIT COLORS)
// ==========================================
var line ln_gvn0_L = na, var line ln_gvn0_R = na, var label lb_gvn0 = na
var line ln_gvn100_L = na, var line ln_gvn100_R = na, var label lb_gvn100 = na
var line ln_i2_L = na, var line ln_i2_R = na, var label lb_i2 = na
var line ln_i3_L = na, var line ln_i3_R = na, var label lb_i3 = na
var line ln_i5_L = na, var line ln_i5_R = na, var label lb_i5 = na
var line ln_i6_L = na, var line ln_i6_R = na, var label lb_i6 = na
var line ln_i7_L = na, var line ln_i7_R = na, var label lb_i7 = na

var line ln_s0_L = na, var line ln_s0_R = na, var label lb_seeda_0 = na
var line ln_s236_L = na, var line ln_s236_R = na, var label lb_seeda_236 = na
var line ln_s382_L = na, var line ln_s382_R = na, var label lb_seeda_382 = na
var line ln_s500_L = na, var line ln_s500_R = na, var label lb_seeda_500 = na
var line ln_s618_L = na, var line ln_s618_R = na, var label lb_seeda_618 = na
var line ln_s786_L = na, var line ln_s786_R = na, var label lb_seeda_786 = na
var line ln_s1000_L = na, var line ln_s1000_R = na, var label lb_seeda_1000 = na

var line ln_ext_up_L = na, var line ln_ext_up_R = na, var label lb_ext_up = na
var line ln_ext_dn_L = na, var line ln_ext_dn_R = na, var label lb_ext_dn = na

update_level_line(ln_left, ln_right, start_time, end_time, price, col_left, width_left, col_right, width_right, is_dual) =>
    line.delete(ln_left)
    line.delete(ln_right)
    line new_left = na
    line new_right = na
    if not na(price)
        if is_dual
            mid_time = start_time + math.round((end_time - start_time) / 2)
            new_left  := line.new(start_time, price, mid_time, price, xloc=xloc.bar_time, color=col_left,  style=line.style_solid, width=width_left)
            new_right := line.new(mid_time,   price, end_time, price, xloc=xloc.bar_time, color=col_right, style=line.style_solid, width=width_right)
        else
            new_left  := line.new(start_time, price, end_time, price, xloc=xloc.bar_time, color=col_left, style=line.style_solid, width=width_left)
    [new_left, new_right]

update_label(lb_ref, price, ratio_text, line_color, start_time, end_time, label_align, show_label, suff_text) =>
    label.delete(lb_ref)
    label new_lb = na
    if not na(price) and show_label
        label_x = (label_align == "left") ? (start_time - 1800000) : end_time
        label_style = (label_align == "left") ? label.style_label_right : label.style_label_left
        new_lb := label.new(label_x, price, ratio_text + " (" + str.tostring(price, "#.##") + ")" + suff_text, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=line_color, style=label_style, size=size.small)
    new_lb

var int startT = na
if (hour(time) == 9 and minute(time) == 15)
    startT := time

bool shouldDrawGVN = isIndexMode or (marketMode == "Option Market") or (marketMode == "Custom Setting")

if shouldDrawGVN and barstate.islast and not na(startT)
    int endT = startT + 22500000 
    
    isCall = str.contains(syminfo.ticker, "CE") or str.contains(syminfo.ticker, "CALL") or str.contains(syminfo.ticker, "C")

    string opt_gvn100_lbl = lbl_opt_gvn100
    if lbl_opt_gvn100 == "Auto"
        opt_gvn100_lbl := isCall ? "0.0" : "0.1"

    string gvn100_ratio = isIndexMode ? "1" : opt_gvn100_lbl
    string i2_ratio     = isIndexMode ? "0.786" : lbl_opt_i2
    string i3_ratio     = isIndexMode ? "0.618" : lbl_opt_i3
    string i5_ratio     = isIndexMode ? "0.5" : lbl_opt_i5
    string i6_ratio     = isIndexMode ? "0.382" : lbl_opt_i6
    string i7_ratio     = isIndexMode ? "0.236" : lbl_opt_i7
    string gvn0_ratio   = isIndexMode ? "0"     : lbl_opt_gvn0
    
    string suff_gvn100      = ""
    string suff_i2          = ""
    string suff_i3          = ""
    string suff_i5          = ""
    string suff_i6          = ""
    string suff_i7          = ""
    string suff_gvn0        = ""
    string suff_seeda_0     = ""
    string suff_seeda_236   = ""
    string suff_seeda_382   = ""
    string suff_seeda_500   = ""
    string suff_seeda_618   = ""
    string suff_seeda_786   = ""
    string suff_seeda_1000  = ""
    string suff_ext_up      = ""
    string suff_ext_dn      = ""

    if isIndexMode
        suff_gvn100      := " put buy expiry day"
        suff_i2          := " put buy"
        suff_i3          := " put buy"
        suff_seeda_500   := " ce buy"
        suff_seeda_618   := " ce buy"
        suff_i5          := " put buy"
        suff_seeda_786   := " ce buy"
        suff_i6          := " target 1"
        suff_i7          := " target 2"
        suff_seeda_236   := " target 2"
        suff_seeda_382   := " target"
        suff_seeda_1000  := " ce expiry day buy"
    else
        opt_suffix = isCall ? "ce" : "pe"
        suff_i2          := " target 2"
        suff_i3          := " target"
        suff_i5          := " " + opt_suffix + " buy"
        suff_i6          := " " + opt_suffix + " buy"
        suff_i7          := " " + opt_suffix + " buy"
        suff_gvn0        := " " + opt_suffix + " expiry day buy"
    
    bool isMainDual = (marketMode == "Main Market")

    // Option Market Mode gets ORIGINAL SINGLE SOLID COLORS! Main Market Mode gets DUAL SPLIT COLORS!
    [ln_gvn0_L_n, ln_gvn0_R_n] = update_level_line(ln_gvn0_L, ln_gvn0_R, startT, endT, gvn0, color_gvn0, 1, #ff9800, 1, isMainDual)
    ln_gvn0_L := ln_gvn0_L_n, ln_gvn0_R := ln_gvn0_R_n
    lb_gvn0 := update_label(lb_gvn0, gvn0, gvn0_ratio, color_gvn0, startT, endT, "right", showFibLabels, suff_gvn0)
    
    [ln_gvn100_L_n, ln_gvn100_R_n] = update_level_line(ln_gvn100_L, ln_gvn100_R, startT, endT, gvn100, color_gvn100, 1, #e91e63, 1, isMainDual)
    ln_gvn100_L := ln_gvn100_L_n, ln_gvn100_R := ln_gvn100_R_n
    lb_gvn100 := update_label(lb_gvn100, gvn100, gvn100_ratio, color_gvn100, startT, endT, "right", showFibLabels, suff_gvn100)
    
    [ln_i2_L_n, ln_i2_R_n] = update_level_line(ln_i2_L, ln_i2_R, startT, endT, i2, color_i2, 2, color.purple, 2, isMainDual)
    ln_i2_L := ln_i2_L_n, ln_i2_R := ln_i2_R_n
    lb_i2 := update_label(lb_i2, i2, i2_ratio, color_i2, startT, endT, "right", showFibLabels, suff_i2)
    
    [ln_i3_L_n, ln_i3_R_n] = update_level_line(ln_i3_L, ln_i3_R, startT, endT, i3, color_i3, 2, #0b2ec9, 2, isMainDual)
    ln_i3_L := ln_i3_L_n, ln_i3_R := ln_i3_R_n
    lb_i3 := update_label(lb_i3, i3, i3_ratio, color_i3, startT, endT, "right", showFibLabels, suff_i3)
    
    [ln_i5_L_n, ln_i5_R_n] = update_level_line(ln_i5_L, ln_i5_R, startT, endT, i5, color_i5, 2, color.green, 2, isMainDual)
    ln_i5_L := ln_i5_L_n, ln_i5_R := ln_i5_R_n
    lb_i5 := update_label(lb_i5, i5, i5_ratio, color_i5, startT, endT, "right", showFibLabels, suff_i5)
    
    [ln_i6_L_n, ln_i6_R_n] = update_level_line(ln_i6_L, ln_i6_R, startT, endT, i6, color_i6, 2, #ff9800, 2, isMainDual)
    ln_i6_L := ln_i6_L_n, ln_i6_R := ln_i6_R_n
    lb_i6 := update_label(lb_i6, i6, i6_ratio, color_i6, startT, endT, "right", showFibLabels, suff_i6)
    
    [ln_i7_L_n, ln_i7_R_n] = update_level_line(ln_i7_L, ln_i7_R, startT, endT, i7, color_i7, 2, color.red, 2, isMainDual)
    ln_i7_L := ln_i7_L_n, ln_i7_R := ln_i7_R_n
    lb_i7 := update_label(lb_i7, i7, i7_ratio, color_i7, startT, endT, "right", showFibLabels, suff_i7)
    
    // Seeda Fibonacci Levels
    [ln_s0_L_n, ln_s0_R_n] = update_level_line(ln_s0_L, ln_s0_R, startT, endT, seeda_0, color.gray, 1, color.blue, 1, isMainDual)
    ln_s0_L := ln_s0_L_n, ln_s0_R := ln_s0_R_n
    lb_seeda_0 := update_label(lb_seeda_0, seeda_0, "0", color.gray, startT, endT, "left", showFibLabels, suff_seeda_0)
    
    [ln_s236_L_n, ln_s236_R_n] = update_level_line(ln_s236_L, ln_s236_R, startT, endT, seeda_236, #ff9800, 1, color.purple, 1, isMainDual)
    ln_s236_L := ln_s236_L_n, ln_s236_R := ln_s236_R_n
    lb_seeda_236 := update_label(lb_seeda_236, seeda_236, "0.236", #ff9800, startT, endT, "left", showFibLabels, suff_seeda_236)
    
    [ln_s382_L_n, ln_s382_R_n] = update_level_line(ln_s382_L, ln_s382_R, startT, endT, seeda_382, #009688, 1, color.blue, 1, isMainDual)
    ln_s382_L := ln_s382_L_n, ln_s382_R := ln_s382_R_n
    lb_seeda_382 := update_label(lb_seeda_382, seeda_382, "0.382", #009688, startT, endT, "left", showFibLabels, suff_seeda_382)
    
    [ln_s500_L_n, ln_s500_R_n] = update_level_line(ln_s500_L, ln_s500_R, startT, endT, seeda_500, color.green, 1, color.blue, 1, isMainDual)
    ln_s500_L := ln_s500_L_n, ln_s500_R := ln_s500_R_n
    lb_seeda_500 := update_label(lb_seeda_500, isIndexMode ? i3 : seeda_500, "0.5", color.green, startT, endT, "left", showFibLabels, suff_seeda_500)
    
    [ln_s618_L_n, ln_s618_R_n] = update_level_line(ln_s618_L, ln_s618_R, startT, endT, seeda_618, #009688, 1, color.purple, 1, isMainDual)
    ln_s618_L := ln_s618_L_n, ln_s618_R := ln_s618_R_n
    lb_seeda_618 := update_label(lb_seeda_618, isIndexMode ? i5 : seeda_618, "0.618", #009688, startT, endT, "left", showFibLabels, suff_seeda_618)
    
    color_seeda_786_eff = isIndexMode ? color.black : #e91e63
    [ln_s786_L_n, ln_s786_R_n] = update_level_line(ln_s786_L, ln_s786_R, startT, endT, seeda_786, color_seeda_786_eff, 1, color.orange, 1, isMainDual)
    ln_s786_L := ln_s786_L_n, ln_s786_R := ln_s786_R_n
    lb_seeda_786 := update_label(lb_seeda_786, seeda_786, "0.786", color_seeda_786_eff, startT, endT, "left", showFibLabels, suff_seeda_786)
    
    [ln_s1000_L_n, ln_s1000_R_n] = update_level_line(ln_s1000_L, ln_s1000_R, startT, endT, seeda_1000, color.gray, 1, color.black, 1, isMainDual)
    ln_s1000_L := ln_s1000_L_n, ln_s1000_R := ln_s1000_R_n
    lb_seeda_1000 := update_label(lb_seeda_1000, seeda_1000, "1", color.gray, startT, endT, "left", showFibLabels, suff_seeda_1000)
    
    [ln_ext_up_L_n, ln_ext_up_R_n] = update_level_line(ln_ext_up_L, ln_ext_up_R, startT, endT, ext_up_1618_ulta, #2196f3, 2, #9c27b0, 2, isMainDual)
    ln_ext_up_L := ln_ext_up_L_n, ln_ext_up_R := ln_ext_up_R_n
    lb_ext_up := update_label(lb_ext_up, ext_up_1618_ulta, "1.618", #2196f3, startT, endT, "right", showFibLabels, suff_ext_up)
    
    [ln_ext_dn_L_n, ln_ext_dn_R_n] = update_level_line(ln_ext_dn_L, ln_ext_dn_R, startT, endT, ext_dn_1618_seeda, #2196f3, 2, #9c27b0, 2, isMainDual)
    ln_ext_dn_L := ln_ext_dn_L_n, ln_ext_dn_R := ln_ext_dn_R_n
    lb_ext_dn := update_label(lb_ext_dn, ext_dn_1618_seeda, "1.618", #2196f3, startT, endT, "right", showFibLabels, suff_ext_dn)

atrVal = ta.atr(in_atrLength)
float slOffset = in_useDynamicSL ? (na(atrVal) ? 12.0 : atrVal * in_atrMult) : 12.0

buyEntry = i5
buyT1    = i3
buyT2    = i2
buySL    = buyEntry - slOffset

var bool buyActive = false

if ta.crossover(close, buyEntry)
    buyActive := true
    if showTradeBoxes
        box.new(bar_index, buyT2, bar_index+10, buyEntry, bgcolor=color.new(#b4ddb6,60), border_color=na, border_width=0)
        box.new(bar_index, buyEntry, bar_index+10, buySL, bgcolor=color.new(#e656c6,60), border_color=na, border_width=0)
     
    if showSLLabels
        label.new(bar_index+5, buySL, "SL: " + str.tostring(buySL), color=color.new(#e656c6, 30), style=label.style_label_up, textcolor=color.white, size=size.small)

if buyActive and (close >= buyT2 or close <= buySL)
    buyActive := false

sellEntry = i7
sellT1    = i6
sellT2    = i5
sellSL    = sellEntry - slOffset

var bool sellActive = false

if ta.crossunder(close, sellEntry)
    sellActive := true
    if showTradeBoxes
        box.new(bar_index, sellEntry, bar_index+10, sellT2, bgcolor=color.new(#a1bba1, 80), border_color=na, border_width=0)
        box.new(bar_index, sellSL, bar_index+10, sellEntry, bgcolor=color.new(#e656c6,80), border_color=na, border_width=0)

    if showSLLabels
        label.new(bar_index+5, sellSL, "SL: " + str.tostring(sellSL), color=color.new(#e656c6, 30), style=label.style_label_down, textcolor=color.white, size=size.small)

if sellActive and (close <= sellT2 or close >= sellSL)
    sellActive := false

thirdEntry = gvn0
thirdT1 = i7
thirdT2 = i6
thirdT3 = i5
thirdSL = thirdEntry - slOffset

var bool thirdActive = false

if ta.crossover(close, thirdEntry)
    thirdActive := true
    if showTradeBoxes
        box.new(bar_index, thirdT3, bar_index+10, thirdEntry, bgcolor=color.new(#b4ddb6, 80), border_color=na, border_width=0)
        box.new(bar_index, thirdEntry, bar_index+10, thirdSL, bgcolor=color.new(#e656c6,80), border_color=na, border_width=0)

    if showSLLabels
        label.new(bar_index+5, thirdSL, "SL: " + str.tostring(thirdSL), color=color.new(#e656c6, 30), style=label.style_label_up, textcolor=color.white, size=size.small)

if thirdActive and (close >= thirdT3 or close <= thirdSL)
    thirdActive := false

// Fixed Range VP POC
var float pocLevel = na
var int last_vp_bar = -1

if showVP and barstate.islast and bar_index != last_vp_bar
    last_vp_bar := bar_index
    a_prices = array.new_float(0)
    a_vols   = array.new_float(0)
    
    for i = 0 to vpLookback - 1
        p = math.round(hlc3[i] / vpStep) * vpStep
        v = volume[i]
        
        idx = array.indexof(a_prices, p)
        if idx >= 0
            array.set(a_vols, idx, array.get(a_vols, idx) + v)
        else
            array.push(a_prices, p)
            array.push(a_vols, v)

    maxV = 0.0
    maxIdx = -1
    for i = 0 to array.size(a_vols) - 1
        if array.get(a_vols, i) > maxV
            maxV := array.get(a_vols, i)
            maxIdx := i
            
    pocLevel := maxIdx >= 0 ? array.get(a_prices, maxIdx) : na

var line pocLine = na
var label pocLabel = na
if showVP and barstate.islast and not na(pocLevel)
    line.delete(pocLine)
    label.delete(pocLabel)
    
    pocLine := line.new(bar_index - 15, pocLevel, bar_index + 10, pocLevel, color=color.rgb(255, 153, 0), width=3, style=line.style_solid)
    if showGVNLabel
        pocLabel := label.new(bar_index + 10, pocLevel, "GVN: " + str.tostring(pocLevel), color=color.rgb(255, 153, 0), textcolor=color.black, style=label.style_label_left, size=size.small)

// VWAP & Trend Lines
plot(ta.vwap, color=color_vwap, title="VWAP", style=plot.style_stepline, linewidth=1)

hcl3 = hlc3
hcl3_52 = ta.sma(hcl3, 52)
plot(hcl3_52, color=color_hcl, title="Hcl", style=plot.style_stepline, linewidth=1)

pivotCandle = (high[1] + low[1] + close[1]) / 3
touchedCandle = high >= pivotCandle and low <= pivotCandle
colorCandle = touchedCandle ? color.new(color_cp, 100) : color_cp
plot(showCP ? pivotCandle : na, title="cp", color=colorCandle, linewidth=1, style=plot.style_stepline)

// ==========================================
// 🕯️ RED OPEN CROSSING TRIGGER & CANDLE COLORING LOGIC
// ==========================================
bool isPreviousRed  = (close[1] < open[1])
bool isCurrentGreen = (close > open)
bool isRedOpenCrossed = isPreviousRed and isCurrentGreen and (close >= open[1])

openLowCandle = (open == low)
openHighCandle = (open == high)

levelTouched = (high >= gvn0 and low <= gvn0) or 
               (high >= gvn100 and low <= gvn100) or 
               (high >= i2 and low <= i2) or 
               (high >= i3 and low <= i3) or 
               (high >= i5 and low <= i5) or 
               (high >= i6 and low <= i6) or 
               (high >= i7 and low <= i7)

seedaTouched = isIndexMode and (
               (high >= seeda_0 and low <= seeda_0) or
               (high >= seeda_236 and low <= seeda_236) or
               (high >= seeda_382 and low <= seeda_382) or
               (high >= seeda_500 and low <= seeda_500) or
               (high >= seeda_618 and low <= seeda_618) or
               (high >= seeda_786 and low <= seeda_786) or
               (high >= seeda_1000 and low <= seeda_1000))

anyLevelTouched = levelTouched or seedaTouched

bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

avgVolume = ta.sma(volume, 10)
highVolume = volume > avgVolume

isSupportRejection   = anyLevelTouched and (lowerWick >= bodySize * 1.5) and highVolume
isResistanceRejection = anyLevelTouched and (upperWick >= bodySize * 1.5) and highVolume

// Target Level 't': Green candle close where Red candle started (Green -> Red reversal top opening level)
var float greenToRedOpenTarget = na
if (close[1] > open[1]) and (close < open)
    greenToRedOpenTarget := open[1]

// Color ONLY previous red candle and current green candle when Red Open is crossed!
var int crossedBarIndex = -1
if isRedOpenCrossed
    crossedBarIndex := bar_index

color barCol = na
if in_colorBars and (bar_index == crossedBarIndex or bar_index == crossedBarIndex - 1)
    barCol := in_bullEngColor
else if in_showExhaustion and (isSupportRejection or isResistanceRejection)
    if isSupportRejection and isResistanceRejection
        barCol := lowerWick > upperWick ? in_exhaustBullColor : in_exhaustBearColor
    else
        barCol := isSupportRejection ? in_exhaustBullColor : in_exhaustBearColor
else if showBarColor and (openLowCandle or openHighCandle)
    barCol := openLowCandle ? in_openLowColor : in_openHighColor

barcolor(barCol)

// ==========================================
// 🎯 EXACT 2-DOT DOTTED LINE MARKINGS FOR e, sl, t (SLIGHTLY LARGER FONT SIZE)
// ==========================================
estSize = in_estFontSize == "tiny" ? size.tiny : in_estFontSize == "small" ? size.small : in_estFontSize == "normal" ? size.normal : size.large

if in_showEST and isRedOpenCrossed
    float ePrice = open[1] // Exact Red Candle Open price that was crossed!
    float slPrice = math.min(low, low[1]) - in_slBuffer
    float tPrice = not na(greenToRedOpenTarget) and greenToRedOpenTarget > ePrice ? greenToRedOpenTarget : (ePrice + (ePrice - slPrice) * 1.5)

    // 1. Entry 'e' - 2-Dot Dotted Line directly at Red Candle Open Level
    line.new(bar_index - 1, ePrice, bar_index + 1, ePrice, color=color.blue, width=1, style=line.style_dotted)
    label.new(bar_index + 1, ePrice, "e", color=color.new(color.blue, 100), textcolor=color.blue, style=label.style_label_left, size=estSize)

    // 2. Stop Loss 'sl' - 2-Dot Dotted Line below Low with 2pt Buffer
    line.new(bar_index - 1, slPrice, bar_index + 1, slPrice, color=color.red, width=1, style=line.style_dotted)
    label.new(bar_index + 1, slPrice, "sl", color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_left, size=estSize)

    // 3. Target 't' - 2-Dot Dotted Line at previous Green-Red Body Opening Level
    line.new(bar_index - 1, tPrice, bar_index + 1, tPrice, color=color.orange, width=1, style=line.style_dotted)
    label.new(bar_index + 1, tPrice, "t", color=color.new(color.orange, 100), textcolor=color.orange, style=label.style_label_left, size=estSize)

// Downside Volume
maxVol = ta.highest(volume, 100)
lowestLow = ta.lowest(low, 100)
highestHigh = ta.highest(high, 100)
chartRange = highestHigh - lowestLow

volBase   = lowestLow - (chartRange * 0.15)
volScaled = volBase + (volume / (maxVol == 0 ? 1 : maxVol)) * (chartRange * 0.08)

volColor = close >= open ? color.new(color.green, 60) : color.new(color.red, 60)

plotVolBase   = plot(volBase, "Volume Base Line", color=color.new(color.gray, 100))
plotVolScaled = plot(volScaled, "Volume Scaled Line", color=color.new(color.gray, 100))

fill(plotVolBase, plotVolScaled, color=volColor, title="Volume Downside Fill")

// Supertrend
atrPeriod = input.int(7, "ATR Length", minval=1)
factor = input.float(0.90, "Factor", minval=0.08, step=0.01)
emaShortPeriod = input.int(5, "EMA 5", minval=1)
emaLongPeriod = input.int(10, "EMA 10", minval=1)

[supertrend, direction] = ta.supertrend(factor, atrPeriod)

emaShort = ta.ema(close, emaShortPeriod)
emaLong  = ta.ema(close, emaLongPeriod)

buySignal  = ta.crossover(close, supertrend)
sellSignal = ta.crossunder(close, supertrend)

plotshape(showBuySellConf ? buySignal : na, title="Buy Signal", location=location.belowbar, color=color.rgb(16, 211, 151), style=shape.labelup, text="buy", textcolor=color.rgb(10, 10, 10), size=size.tiny)
plotshape(showBuySellConf ? sellSignal : na, title="Sell Signal", location=location.abovebar, color=color.rgb(216, 109, 211), style=shape.labeldown, text="sell", textcolor=color.rgb(27, 25, 25), size=size.tiny)

alertcondition(buySignal, title="Buy Alert", message="Supertrend Buy Signal")
alertcondition(sellSignal, title="Sell Alert", message="Supertrend Sell Signal")

// Tables Position
posConvert(pos)=>
     pos=="Top Left"?position.top_left:
     pos=="Middle Left"?position.middle_left:
     pos=="Bottom Left"?position.bottom_left:
     pos=="Top Center"?position.top_center:
     pos=="Middle Center"?position.middle_center:
     pos=="Bottom Center"?position.bottom_center:
     pos=="Top Right"?position.top_right:
     pos=="Middle Right"?position.middle_right:
     position.bottom_right

firstTablePos  = posConvert(firstPosInput)
secondTablePos = posConvert(secondPosInput)
thirdTablePos  = posConvert(thirdPosInput)

fontSize = tableFont == "tiny" ? size.tiny : tableFont == "small" ? size.small : tableFont == "normal" ? size.normal : size.large

var table table1 = na
if showTable1 and na(table1)
    table1 := table.new(firstTablePos, 2, 3, border_width=1, border_color=color.rgb(19, 73, 160), frame_color=color.rgb(19, 73, 160), frame_width=1)

if showTable1 and barstate.islast
    color t1_headBg = buyActive ? color.rgb(163, 211, 151) : #1e3a8a
    color t1_headTx = buyActive ? color.black : color.white
    color t1_bg     = buyActive ? color.rgb(200, 230, 200) : color.rgb(20, 35, 60)
    color t1_txt    = buyActive ? color.black : color.rgb(130, 190, 250)
    
    table.cell(table1, 0, 0, "1st Entry 📈", bgcolor=t1_headBg, text_color=t1_headTx, text_size=fontSize)
    table.cell(table1, 0, 1, "Target 1", bgcolor=t1_bg, text_color=t1_txt, text_size=fontSize)
    table.cell(table1, 0, 2, "Target 2", bgcolor=t1_bg, text_color=t1_txt, text_size=fontSize)

    table.cell(table1, 1, 0, str.tostring(buyEntry), bgcolor=t1_bg, text_color=t1_txt, text_size=fontSize)
    table.cell(table1, 1, 1, str.tostring(buyT1),    bgcolor=t1_bg, text_color=t1_txt, text_size=fontSize)
    table.cell(table1, 1, 2, str.tostring(buyT2),    bgcolor=t1_bg, text_color=t1_txt, text_size=fontSize)

var table table2 = na
if showTable2 and na(table2)
    table2 := table.new(secondTablePos, 2, 3, border_width=1, border_color=color.rgb(19, 73, 160), frame_color=color.rgb(19, 73, 160), frame_width=1)

if showTable2 and barstate.islast
    color t2_headBg = sellActive ? color.rgb(226, 144, 144) : #1e3a8a
    color t2_headTx = sellActive ? color.black : color.white
    color t2_bg     = sellActive ? color.rgb(240, 200, 200) : color.rgb(20, 35, 60)
    color t2_txt    = sellActive ? color.black : color.rgb(130, 190, 250)

    table.cell(table2, 0, 0, "2nd Entry 📉", bgcolor=t2_headBg, text_color=t2_headTx, text_size=fontSize)
    table.cell(table2, 0, 1, "Target 1", bgcolor=t2_bg, text_color=t2_txt, text_size=fontSize)
    table.cell(table2, 0, 2, "Target 2", bgcolor=t2_bg, text_color=t2_txt, text_size=fontSize)

    table.cell(table2, 1, 0, str.tostring(sellEntry), bgcolor=t2_bg, text_color=t2_txt, text_size=fontSize)
    table.cell(table2, 1, 1, str.tostring(sellT1),    bgcolor=t2_bg, text_color=t2_txt, text_size=fontSize)
    table.cell(table2, 1, 2, str.tostring(sellT2),    bgcolor=t2_bg, text_color=t2_txt, text_size=fontSize)

var table table3 = na
if showTable3 and na(table3)
    table3 := table.new(thirdTablePos, 2, 4, border_width=1, border_color=color.rgb(19, 73, 160), frame_color=color.rgb(19, 73, 160), frame_width=1)

if showTable3 and barstate.islast
    color t3_headBg = thirdActive ? color.rgb(33, 150, 243) : #1e3a8a
    color t3_headTx = thirdActive ? color.white : color.white
    color t3_bg     = thirdActive ? color.rgb(200, 220, 250) : color.rgb(20, 35, 60)
    color t3_txt    = thirdActive ? color.black : color.rgb(130, 190, 250)

    table.cell(table3, 0, 0, "Z to H 🚀", bgcolor=t3_headBg, text_color=t3_headTx, text_size=fontSize)
    table.cell(table3, 0, 1, "Target 1", bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)
    table.cell(table3, 0, 2, "Target 2", bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)
    table.cell(table3, 0, 3, "Target 3", bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)

    table.cell(table3, 1, 0, str.tostring(thirdEntry), bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)
    table.cell(table3, 1, 1, str.tostring(thirdT1),    bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)
    table.cell(table3, 1, 2, str.tostring(thirdT2),    bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)
    table.cell(table3, 1, 3, str.tostring(thirdT3),    bgcolor=t3_bg, text_color=t3_txt, text_size=fontSize)

// 80% Levels
prevHigh = ta.highest(high, 1)[1]
prevLow = ta.lowest(low, 1)[1]
range80 = (prevHigh - prevLow) * 0.8
upperLevel = prevLow + range80
lowerLevel = prevHigh - range80

if show80Lines
    var line upperLine = na
    var line lowerLine = na
    line.delete(upperLine)
    line.delete(lowerLine)
    upperLine := line.new(x1=bar_index, y1=upperLevel, x2=bar_index + 500, y2=upperLevel, width=1, color=color.rgb(131, 196, 134), style=line.style_solid)
    lowerLine := line.new(x1=bar_index, y1=lowerLevel, x2=bar_index + 500, y2=lowerLevel, width=1, color=color.rgb(226, 144, 144), style=line.style_solid)

float GVNS = ta.valuewhen(ta.highestbars(volume, 50) == 0, close, 0)
plot(showGVNS ? GVNS : na, title="GVNS Level", color=color.new(color.black, 0), linewidth=2)

// RSI AI Dashboard
aiFontSize = aiFontInput == "tiny" ? size.tiny : aiFontInput == "small" ? size.small : aiFontInput == "normal" ? size.normal : size.large

tHour = hour(time, "Asia/Kolkata")
tMin = minute(time, "Asia/Kolkata")
float timeVal = tHour + (tMin / 60.0)

rsiVal = ta.rsi(close, 14)

bool isBullishTrend = (close > ta.vwap) and (rsiVal >= 50.0)
bool isBearishTrend = (close < ta.vwap) and (rsiVal < 50.0)

string timeZoneStatus = "DULL ZONE 🟡 (Wait ⚠️)"
color tzColor = color.rgb(120, 123, 134)

if (timeVal >= 9.25 and timeVal <= 10.5) 
    if isBullishTrend
        timeZoneStatus := "MARKET UP 🟢 (Morning)"
        tzColor := color.rgb(16, 231, 124)
    else if isBearishTrend
        timeZoneStatus := "MARKET DOWN 🔴 (Morning)"
        tzColor := color.rgb(226, 144, 144)
    else
        timeZoneStatus := "DULL ZONE 🟡 (Wait ⚠️)"
        tzColor := color.rgb(243, 201, 64)
else if (timeVal >= 13.5 and timeVal <= 15.0) 
    if isBullishTrend
        timeZoneStatus := "MARKET UP 🚀 (Breakout)"
        tzColor := color.rgb(33, 150, 243)
    else if isBearishTrend
        timeZoneStatus := "MARKET DOWN 🩸 (Breakout)"
        tzColor := color.rgb(226, 144, 144)
    else
        timeZoneStatus := "DULL ZONE 🟡 (Wait ⚠️)"
        tzColor := color.rgb(243, 201, 64)
else
    if isBullishTrend
        timeZoneStatus := "MARKET UP 🟢 (Consolidating)"
        tzColor := color.rgb(16, 231, 124)
    else if isBearishTrend
        timeZoneStatus := "MARKET DOWN 🔴 (Consolidating)"
        tzColor := color.rgb(226, 144, 144)
    else
        timeZoneStatus := "DULL ZONE 🟡 (Wait ⚠️)"
        tzColor := color.rgb(120, 123, 134)

float lowerL = na
float upperL = na

if close >= gvn100
    lowerL := gvn100
    upperL := gvn100 + gvnR
else if close >= i2
    lowerL := i2
    upperL := gvn100
else if close >= i3
    lowerL := i3
    upperL := i2
else if close >= i5
    lowerL := i5
    upperL := i3
else if close >= i6
    lowerL := i6
    upperL := i5
else if close >= i7
    lowerL := i7
    upperL := i6
else
    lowerL := gvn0
    upperL := i7

string rangeStr = ""
if not na(lowerL) and not na(upperL)
    if rsiVal >= 50.0
        rangeStr := " ( " + str.tostring(math.round(lowerL)) + " - " + str.tostring(math.round(upperL)) + " )"
    else
        rangeStr := " ( " + str.tostring(math.round(upperL)) + " - " + str.tostring(math.round(lowerL)) + " )"

bool rsiNear50 = (rsiVal >= 49.0 and rsiVal <= 51.0)
bool blinkToggle = (math.floor(timenow / 500) % 2 == 0)

color rsiCellBg = rsiNear50 ? (blinkToggle ? color.rgb(255, 153, 0) : color.yellow) : (rsiVal >= 50.0 ? color.rgb(16, 231, 124) : color.rgb(226, 144, 144))
string rsiStatusText = "RSI: " + str.tostring(rsiVal, "#.##") + rangeStr
if rsiNear50
    rsiStatusText := "RSI: " + str.tostring(rsiVal, "#.##") + rangeStr + " ⚡ (Sync 50)"

color rsiTextCol = rsiNear50 ? color.black : (rsiVal >= 50.0 ? color.black : color.rgb(180, 0, 0))

int sliderPos = math.round((rsiVal - 30.0) / 40.0 * 10)
sliderPos := math.max(0, math.min(10, sliderPos))

string rsiSliderStr = "30 ["
for i = 0 to 10
    if i == sliderPos
        rsiSliderStr := rsiSliderStr + "●"
    else if i == 5
        rsiSliderStr := rsiSliderStr + "┼"
    else
        rsiSliderStr := rsiSliderStr + "─"
rsiSliderStr := rsiSliderStr + "] 70"

aiPosConvert(p) =>
    p == "Top Left" ? position.top_left :
     p == "Middle Left" ? position.middle_left :
     p == "Bottom Left" ? position.bottom_left :
     p == "Top Center" ? position.top_center :
     p == "Middle Center" ? position.middle_center :
     p == "Bottom Center" ? position.bottom_center :
     p == "Top Right" ? position.top_right :
     p == "Middle Right" ? position.middle_right :
     position.bottom_right

var table dashboardTable = na
if showAI and barstate.islast
    table.delete(dashboardTable)
    dashboardTable := table.new(aiPosConvert(aiBoxPos), 1, 4, border_width=2, border_color=color.black, frame_color=color.black, frame_width=2)
    
    table.cell(dashboardTable, 0, 0, "🤖 GVN AI DASHBOARD", bgcolor=color.black, text_color=color.white, text_size=aiFontSize)
    table.cell(dashboardTable, 0, 1, "Zone: " + timeZoneStatus, bgcolor=tzColor, text_color=color.black, text_size=aiFontSize, text_halign=text.align_left)
    table.cell(dashboardTable, 0, 2, rsiStatusText, bgcolor=rsiCellBg, text_color=rsiTextCol, text_size=aiFontSize, text_halign=text.align_left)
    table.cell(dashboardTable, 0, 3, rsiSliderStr, bgcolor=color.rgb(240, 240, 240), text_color=color.black, text_size=aiFontSize, text_halign=text.align_center)

// Institutional Zones
cBody = math.abs(close - open)
avgV = ta.sma(volume, 20)
avgB = ta.sma(cBody, 20)
buyVolFlow = (close >= open) ? volume : 0.0
sellVolFlow = (close < open) ? volume : 0.0
deltaFlow = buyVolFlow - sellVolFlow
avgDelta = ta.sma(deltaFlow, 10)
bool isInstPump = volume > (avgV * 2.5) and cBody <= avgB

var box supportBox = na
var box resistBox  = na

if showInstZones and isInstPump
    if avgDelta > 0
        supportBox := box.new(left=bar_index, top=low, right=bar_index + 50, bottom=low - (high-low)*0.1, bgcolor=color.new(color.lime, 90), border_color=color.new(color.lime, 60), text="SUP", text_size=size.tiny, text_color=color.lime, text_halign=text.align_right)
    else
        resistBox := box.new(left=bar_index, top=high + (high-low)*0.1, right=bar_index + 50, bottom=high, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 60), text="RES", text_size=size.tiny, text_color=color.red, text_halign=text.align_right)

if not na(supportBox)
    box.set_right(supportBox, bar_index + 20)
if not na(resistBox)
    box.set_right(resistBox, bar_index + 20)

// Algo Perfect Signals
volUp = close > open ? volume : 0.0
volDn = close < open ? volume : 0.0
sumVolUp = math.sum(volUp, 20)
sumVolDn = math.sum(volDn, 20)
volRatio = sumVolUp / (sumVolDn == 0.0 ? 1.0 : sumVolDn)

buyPrevHighBreak = close > high[1]
sellPrevLowBreak = close < low[1]

volSpike = volume > ta.sma(volume, 20) * 1.5

aiBullishStrong = (volRatio > 1.0) or (avgDelta > 0)
aiBearishStrong = (volRatio < 1.0) or (avgDelta < 0)

touchedi5 = ta.barssince(low <= i5 and close >= i5) <= 3
touchedi7 = ta.barssince(high >= i7 and close <= i7) <= 3

strictBuyAlgo = touchedi5 and buyPrevHighBreak and volSpike and aiBullishStrong
strictSellAlgo = touchedi7 and sellPrevLowBreak and volSpike and aiBearishStrong

accelFlash = cBody > avgB * 2.0 and volSpike 

plotshape(showAlgoSignals and strictBuyAlgo, title="Algo Perfect Buy", location=location.belowbar, color=color.new(color.lime, 0), style=shape.triangleup, text="🚀", textcolor=color.black, size=size.tiny)
plotshape(showAlgoSignals and strictSellAlgo, title="Algo Perfect Sell", location=location.abovebar, color=color.new(color.red, 0), style=shape.triangledown, text="🩸", textcolor=color.white, size=size.tiny)

plotshape(showMomentumFlashes and accelFlash and close > open, title="Bullish Flash", location=location.belowbar, color=color.new(color.yellow, 0), style=shape.circle, text="⚡", textcolor=color.yellow, size=size.tiny)
plotshape(showMomentumFlashes and accelFlash and close < open, title="Bearish Flash", location=location.abovebar, color=color.new(color.orange, 0), style=shape.circle, text="⚡", textcolor=color.orange, size=size.tiny)

// 200 EMA + BB
emaLen = input.int(200, minval=1, title="EMA Length", group="200 EMA Settings")
emaSrc = input.source(close, title="Source", group="200 EMA Settings")
emaOffset = input.int(title="Offset", defval=0, minval=-500, maxval=500, group="200 EMA Settings")
outEma = ta.ema(emaSrc, emaLen)

plot(show200EMA ? outEma : na, title="Main 200 EMA", color=emaColor, linewidth=2, offset=emaOffset)

GRP_SMOOTH = "200 EMA Smoothing"
TT_BB = "Only applies when 'SMA + Bollinger Bands' is selected."
maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GRP_SMOOTH)
isBB = maTypeInput == "SMA + Bollinger Bands"
maLengthInput = input.int(14, "Length", group = GRP_SMOOTH)
bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = GRP_SMOOTH)
enableMA = maTypeInput != "None"

get_smoothed_ma(source, length, MAtype) =>
    switch MAtype
        "SMA"                   => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA"                   => ta.ema(source, length)
        "SMMA (RMA)"            => ta.rma(source, length)
        "WMA"                   => ta.wma(source, length)
        "VWMA"                  => ta.vwma(source, length)
        => na

smoothingMA = enableMA ? get_smoothed_ma(outEma, maLengthInput, maTypeInput) : na
smoothingStDev = isBB ? ta.stdev(outEma, maLengthInput) * bbMultInput : na

plot(show200EMA and enableMA ? smoothingMA : na, "EMA-based MA", color=color.yellow)
bbUpperBand = plot(show200EMA and isBB ? smoothingMA + smoothingStDev : na, title = "Upper Bollinger Band", color=color.green)
bbLowerBand = plot(show200EMA and isBB ? smoothingMA - smoothingStDev : na, title = "Lower Bollinger Band", color=color.green)
fill(bbUpperBand, bbLowerBand, color = show200EMA and isBB ? color.new(color.green, 90) : na, title="Bollinger Bands Background Fill")
